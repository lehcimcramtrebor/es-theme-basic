<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<corners>6</corners>
		<cornersOfMedias>8</cornersOfMedias>
		<simpleMode>${system.name} == "retrobat"</simpleMode>
		<favoriteSystem>${system.name} == "favorites"</favoriteSystem>
		<borderFrame>./../parts/framewsel.png</borderFrame>
	</variables>

	<customView name="content" inherits="grid" displayName="${lang.content}">

		<text name="gameName">
			<visible>false</visible>
		</text>

		<image name="md_thumbnail">
			<zIndex>1001</zIndex>
			<linearSmooth>true</linearSmooth>
			<saturation>1.1</saturation>
			<origin>0.5 0</origin>
			<pos>0.8799479166666667 0.6740740740740741</pos>
			<maxSize>0.1369791666666667 0.2259259259259259</maxSize>
			<roundCorners>0.018</roundCorners>
			<visible>true</visible>
			<opacity>1</opacity>
			<scale>1</scale>
			
			<storyboard event="open">
				<animation property="scale" from="0" to="1" mode="linear" duration="1"/>
				<animation property="opacity" from="0" to="0" mode="linear" duration="10"/>
				<animation property="opacity" from="0" to="1" mode="linear" duration="50" begin="10"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="scale" from="0" to="1" mode="linear" duration="1"/>
				<animation property="opacity" from="0" to="0" mode="linear" duration="10"/>
				<animation property="opacity" from="0" to="1" mode="linear" duration="50" begin="10"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="scale" from="0" to="1" mode="linear" duration="1"/>
				<animation property="opacity" from="0" to="0" mode="linear" duration="10"/>
				<animation property="opacity" from="0" to="1" mode="linear" duration="50" begin="10"/>
			</storyboard>
			<storyboard event="deactivatePrev">
			</storyboard>
			<storyboard event="deactivateNext">
			</storyboard>

		</image>

		<image name="md_image">
			<visible>false</visible>
		</image>

		<text name="md_description">
			<visible>false</visible>
		</text>

		<control name="md_description">
			<visible>false</visible>
		</control>

		<image name="logo"
			origin="0 0.5"
			x="0.025"
		/>

		<imagegrid name="gamegrid"
			zIndex="1001"
			pos="0.025 0.205"
			size="${v.frame.size}"
			margin="0.006 0.040"
			autoLayout="3 4"
			animateSelection="false"
			centerSelection="false"
			scrollbarColor="${c.textHeader}"
			scrollbarCorner="0.9"
			scrollbarSize="${v.line.hc}"
			scrollbarAlignment="right"
			scrollSound="./../parts/scroll.wav"
		>
			<autoLayout if="${simpleMode}">3 5</autoLayout>
			<autoLayout if="${s.notWide}">2 4</autoLayout>
			<autoLayout if="${s.ultraWide}">4 4</autoLayout>

			<itemTemplate>
				<container name="contentRoot">
					<pos>0 0</pos>
					<size>1 1</size>
					<padding>0 0 0 3</padding>
					<opacity>1</opacity>
					<container>
						<image>
							<path>./../parts/white.png</path>
							<pos>0 0</pos>
							<origin>0 0</origin>
							<size>1 1</size>
							<color>${c.frame}</color>
							<roundCorners>${corners}</roundCorners>
							<zIndex>2</zIndex>
							<image name="shade">
								<visible>!exists({game:thumbnail})</visible>
								<path>./../parts/bg.png</path>
								<pos>0 0</pos>
								<origin>0 0</origin>
								<size>1 1</size>
								<color>FFFFFF16</color>
								<roundCorners>${corners}</roundCorners>
							</image>
						</image>
						<container clipChildren="true">
							<image name="backgroundOfTile" if="!${simpleMode}">
								<path>{game:thumbnail}</path>
								<origin>0.5</origin>
								<pos>0.5</pos>
								<minSize>1 1</minSize>
								<linearSmooth>true</linearSmooth>
								<zIndex>3</zIndex>
								<color>FFFFFF1A</color>
								<roundCorners>${corners}</roundCorners>
								<storyboard event="activate" repeat="forever">
									<animation property="scale" from="1" to="1.1" duration="5000"/>
									<animation property="scale" begin="5000" to="1" duration="5000"/>
								</storyboard>
								<storyboard event="deactivate">
									<animation property="scale" to="1" duration="250"/>
								</storyboard>
							</image>
						</container>
						<container padding="-8" zIndex="1">
							<ninepatch>
								<pos>0 0</pos>
								<size>1 1</size>
								<path>./../parts/framew.png</path>
								<cornerSize>20 20</cornerSize>
								<padding>-2 -2</padding>
								<color>000000B0</color>
								<zIndex>3</zIndex>
								<storyboard event="activate" repeat="forever">
									<animation property="path" to="${borderFrame}"/>
									<animation property="padding" to="-15 -15"/>
									<animation property="cornerSize" to="36 36"/>
									<animation property="color" from="${c.main}" to="${c.menuSelector}" duration="1500" mode="easeOut"/>
									<animation property="color" from="${c.menuSelector}" to="${c.main}" begin="1500" duration="1500" mode="easeOut"/>
								</storyboard>
								<storyboard event="deactivate">
									<animation property="path" to="./../parts/framew.png"/>
									<animation property="color" to="000000B0"/>
									<animation property="padding" to="-2 -2"/>
									<animation property="cornerSize" to="20 20"/>
								</storyboard>
							</ninepatch>
						</container>
					</container>

					<stackpanel>
						<pos>0 0</pos>
						<size>1 1</size>
						<container name="spacer" w="0.007"/>
						<container>
							<w>{grid:h}</w>
							<image name="imageOfGame" if="!${simpleMode}" shared="false">
								<path>{game:image}</path>
								<origin>0.5</origin>
								<pos>0.5</pos>
								<maxSize>0.93 0.90</maxSize>
								<linearSmooth>true</linearSmooth>
								<zIndex>40</zIndex>
								<color>FFFFFFE0</color>
								<roundCorners>{game:folder} ? 0 : ${cornersOfMedias}</roundCorners>
								<shader>
									<path>:/shaders/border.glsl</path>
									<cornerRadius>${cornersOfMedias}</cornerRadius>
									<borderSize>1</borderSize>
									<borderColor>00000080</borderColor>
									<innerShadowSize>0</innerShadowSize>
									<outerShadowSize>3</outerShadowSize>
									<outerShadowColor>00000080</outerShadowColor>
								</shader>
								<storyboard event="activate">
									<animation property="color" to="white"/>
								</storyboard>
								<storyboard event="deactivate">
									<animation property="color" to="FFFFFFE0"/>
								</storyboard>
								<storyboard event="activate" ifSubset="gridVideos:yes">
									<animation property="color" to="white"/>
									<animation enabled="exists({game:video})" property="opacity" to="1"/>
									<animation enabled="exists({game:video})" property="opacity" begin="300" from="1" to="0" duration="300"/>
								</storyboard>
								<storyboard event="deactivate" ifSubset="gridVideos:yes">
									<animation property="color" to="FFFFFFE0"/>
									<animation enabled="exists({game:video})" property="opacity" to="1" duration="150"/>
								</storyboard>
							</image>
							<video if="!${simpleMode}" ifSubset="gridVideos:yes">
								<visible>exists({game:video})</visible>
								<path>{game:video}</path>
								<origin>0.5</origin>
								<pos>0.5</pos>
								<maxSize>0.93 0.90</maxSize>
								<roundCorners>${cornersOfMedias}</roundCorners>
								<linearSmooth>false</linearSmooth>
								<zIndex>41</zIndex>
								<enabled>false</enabled>
								<storyboard event="activate">
									<animation property="opacity" to="0"/>
									<animation property="enabled" begin="0" to="true"/>
									<animation property="opacity" begin="300" from="0" to="1" duration="300" mode="easeIn"/>
									<animation property="scale" to="0"/>
									<animation property="scale" begin="300" from="0.5" to="1" duration="300" mode="easeOut"/>
								</storyboard>
								<storyboard event="deactivate">
									<animation property="enabled" to="false" begin="150"/>
									<animation property="opacity" from="1" to="0" duration="150"/>
									<animation property="scale" from="1" to="0.5" duration="150"/>
								</storyboard>
								<shader>
									<path>:/shaders/border.glsl</path>
									<cornerRadius>${cornersOfMedias}</cornerRadius>
									<borderSize>0</borderSize>
									<borderColor>00000000</borderColor>
									<innerShadowSize>0</innerShadowSize>
									<outerShadowSize>3</outerShadowSize>
									<outerShadowColor>00000080</outerShadowColor>
								</shader>
							</video>
							<image name="imageMarquee">
								<visible>!{game:folder} &amp;&amp; !exists({game:image})</visible>
								<visible if="${simpleMode}">!{game:folder}</visible>
								<path>{game:marquee}</path>
								<default>:/cartridge.svg</default>
								<origin>0.5</origin>
								<pos>0.5</pos>
								<maxSize>0.90 0.75</maxSize>
								<linearSmooth>true</linearSmooth>
								<zIndex>40</zIndex>
								<color>white</color>
							</image>
							<image name="imageFolder">
								<visible>{game:folder} &amp;&amp; !exists({game:image})</visible>
								<path>:/folder.svg</path>
								<origin>0.5</origin>
								<pos>0.5</pos>
								<maxSize>0.95 0.75</maxSize>
								<linearSmooth>true</linearSmooth>
								<zIndex>40</zIndex>
								<color>white</color>
							</image>
						</container>
						<container name="spacer2" w="0.007"/>
						<container name="atright">
							<padding>8 6 12 6</padding>
							<container>
								<stackpanel reverse="true">
									<stackpanel name="panelFav" orientation="vertical" w="{grid:h} * 0.21" separator="4">
										<image name="favoriteIcon" if="!${favoriteSystem}">
											<visible>{game:favorite}</visible>
											<path>./../resources/fontoverrides/F006.png</path>
											<pos>0 0</pos>
											<origin>0 0</origin>
											<maxSize>1 1</maxSize>
											<horizontalAlignment>right</horizontalAlignment>
											<saturation>{game:favorite} ? 1 : 0</saturation>
											<opacity>{game:favorite} ? 1 : 0.2</opacity>
											<color>FFFFFFFF</color>
										</image>
										<image if="${system.cheevos}">
											<visible>{game:cheevos} &amp;&amp; {system:showCheevos}</visible>
											<path>./../resources/fontoverrides/F091.png</path>
											<pos>0 0</pos>
											<origin>0 0</origin>
											<maxSize>1 1</maxSize>
											<horizontalAlignment>right</horizontalAlignment>
											<saturation>{game:cheevos} ? 1 : 0</saturation>
											<opacity>{game:cheevos} ? 1 : 0.2</opacity>
											<color>FFFFFFFF</color>
										</image>
										<image>
											<visible>{game:hasManual} &amp;&amp; {system:showManual}</visible>
											<path>./../resources/fontoverrides/F02D.png</path>
											<pos>0 0</pos>
											<origin>0 0</origin>
											<maxSize>1 1</maxSize>
											<horizontalAlignment>right</horizontalAlignment>
											<saturation>{game:hasManual} ? 1 : 0</saturation>
											<opacity>{game:hasManual} ? 1 : 0.2</opacity>
											<color>FFFFFFFF</color>
										</image>
										<image>
											<visible>{game:savestate} &amp;&amp; {system:showSaveStates}</visible>
											<path>./../resources/fontoverrides/F0C7.png</path>
											<pos>0 0</pos>
											<origin>0 0</origin>
											<maxSize>1 1</maxSize>
											<horizontalAlignment>right</horizontalAlignment>
											<saturation>{game:savestate} ? 1 : 0</saturation>
											<opacity>{game:savestate} ? 1 : 0.2</opacity>
											<color>FFFFFFFF</color>
										</image>
										<image>
											<visible>{game:gunGame} &amp;&amp; {system:showGun}</visible>
											<path>./../resources/fontoverrides/F05B.png</path>
											<pos>0 0</pos>
											<origin>0 0</origin>
											<maxSize>1 1</maxSize>
											<horizontalAlignment>right</horizontalAlignment>
											<saturation>{game:gunGame} ? 1 : 0</saturation>
											<opacity>{game:gunGame} ? 1 : 0.2</opacity>
											<color>FFFFFFFF</color>
										</image>
										<image>
											<visible>{game:wheelGame} &amp;&amp; {system:showWheel}</visible>
											<path>./../resources/fontoverrides/F1B9.png</path>
											<pos>0 0</pos>
											<origin>0 0</origin>
											<maxSize>1 1</maxSize>
											<horizontalAlignment>right</horizontalAlignment>
											<saturation>{game:wheelGame} ? 1 : 0</saturation>
											<opacity>{game:wheelGame} ? 1 : 0.2</opacity>
											<color>FFFFFFFF</color>
										</image>
									</stackpanel>
									<container>
										<size>1 1</size>
										<stackpanel>
											<size>1 0.3</size>
											<pos>0 0</pos>
											<separator>4</separator>
											<text name="the_game_name">
												<pos>0 0</pos>
												<origin>0 0</origin>
												<size>0 1</size>
												<text>{game:nameShort}</text>
												<fontPath>./../fonts/${f.mb}</fontPath>
												<fontSize>0.018</fontSize>
												<forceUppercase>true</forceUppercase>
												<verticalAlignment>bottom</verticalAlignment>
												<multiLine>false</multiLine>
												<color>${c.selected}</color>
												<glowColor>${c.glowColor}</glowColor>
												<glowOffset>2</glowOffset>
												<glowSize>1</glowSize>
												<autoScrollDelay>1</autoScrollDelay>
												<storyboard event="activate">
													<animation property="autoScroll" to="horizontal"/>
												</storyboard>
												<storyboard event="deactivate">
													<animation property="autoScroll" to="false"/>
												</storyboard>
											</text>
											<text name="the_game_extra">
												<pos>0 0</pos>
												<origin>0 0</origin>
												<size>0 1</size>
												<text>{game:nameExtra}</text>
												<extraTextColor>${c.textHeader}</extraTextColor>
												<color>${c.selected}</color>
												<glowColor>${c.glowColor}</glowColor>
												<glowOffset>2</glowOffset>
												<glowSize>1</glowSize>
												<fontPath>./../fonts/${f.mr}</fontPath>
												<fontSize>0.014</fontSize>
												<forceUppercase>true</forceUppercase>
												<verticalAlignment>bottom</verticalAlignment>
												<multiLine>false</multiLine>
												<autoScrollDelay>1</autoScrollDelay>
												<storyboard event="activate">
													<animation property="autoScroll" to="horizontal"/>
												</storyboard>
												<storyboard event="deactivate">
													<animation property="autoScroll" to="false"/>
												</storyboard>
											</text>
										</stackpanel>
										<stackpanel name="stars_and_system">
											<visible>!{game:folder}</visible>
											<pos>0 0.27</pos>
											<size>1 0.17</size>
											<separator>4</separator>
											<text if="!${simpleMode}">
												<pos>0 0</pos>
												<size>0 1</size>
												<text>{game:stars}</text>
												<color>${c.yellow}</color>
												<fontPath>./../fonts/${f.mr}</fontPath>
												<fontSize>0.016</fontSize>
												<glowColor>${c.glowColor}</glowColor>
												<glowOffset>2</glowOffset>
												<glowSize>1</glowSize>
												<verticalAlignment>top</verticalAlignment>
												<multiLine>false</multiLine>
											</text>
											<text if="!${simpleMode} &amp;&amp; ${system.showSystemName}">
												<pos>0 0</pos>
												<size>0 1</size>
												<text>"[" + {game:system} + "]"</text>
												<color>${c.textHeader}</color>
												<fontPath>./../fonts/${f.mb}</fontPath>
												<fontSize>0.016</fontSize>
												<glowColor>${c.glowColor}</glowColor>
												<glowOffset>2</glowOffset>
												<glowSize>1</glowSize>
												<forceUppercase>true</forceUppercase>
												<verticalAlignment>top</verticalAlignment>
												<multiLine>false</multiLine>
											</text>
										</stackpanel>
										<text>
											<pos>0 0.48</pos>
											<size>1 0.52</size>
											<text>{game:desc}</text>
											<color>${c.selected}</color>
											<glowColor>${c.glowColor}</glowColor>
											<glowOffset>2</glowOffset>
											<glowSize>1</glowSize>
											<fontPath>./../fonts/${f.mr}</fontPath>
											<fontSize>0.016</fontSize>
											<forceUppercase>true</forceUppercase>
											<autoScroll>false</autoScroll>
											<multiLine>true</multiLine>
											<lineSpacing>1.25</lineSpacing>
											<autoScrollDelay>250</autoScrollDelay>
											<verticalAlignment>top</verticalAlignment>
											<storyboard event="activate">
												<animation property="autoScroll" to="vertical"/>
											</storyboard>
											<storyboard event="deactivate">
												<animation property="autoScroll" to="false"/>
											</storyboard>
										</text>
									</container>
								</stackpanel>
							</container>
						</container>
					</stackpanel>
				</container>
			</itemTemplate>
		</imagegrid>
	</customView>
</theme>
